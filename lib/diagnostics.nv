fn lexer_error(message: str) : void {
    nova_runtime_error("LexerError: " + message);
}

fn lexer_error_at(file: str, line: int, column: int, message: str) : void {
    if (str_eq(file, "") && line == 0 && column == 0) {
        nova_runtime_error("LexerError: " + message);
    }
    nova_runtime_error(file + ":" + int_to_str(line) + ":" + int_to_str(column) + ": LexerError: " + message);
}

fn parser_error(message: str) : void {
    parser_error_at("", 0, 0, message);
}

fn parser_error_at(file: str, line: int, column: int, message: str) : void {
    if (str_eq(file, "") && line == 0 && column == 0) {
        nova_runtime_error("ParserError: " + message);
